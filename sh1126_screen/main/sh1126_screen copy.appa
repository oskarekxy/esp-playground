#include <stdio.h>

#define uchar unsigned char
#define uint unsigned int

#include "driver/gpio.h"
#include "driver/spi_master.h"
#include "esp_log.h"
#include "freertos/task.h"

#include "font.h"
#include <string.h>

#include "esp_timer.h"
